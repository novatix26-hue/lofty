# ==============================================================================
# LOFTY LMS ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Supabase Project URL (Found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (Safe for browser client & RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY - Bypasses RLS)
# Used for server-side quiz grading, admin receipt reviews, and session synchronization
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Postgres Connection String (Used for automated database migrations)
# Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Application Base URL (Used for auth redirects and absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
