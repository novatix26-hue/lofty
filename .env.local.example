# ==============================================================================
# LOFTY LMS LOCAL ENVIRONMENT VARIABLES (.env.local)
# Copy this file to .env.local and populate the values from your Supabase Dashboard
# ==============================================================================

# 1. Supabase Project URL (Public)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public API Key (Client-side & RLS enforced)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'anon' / 'public'
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'service_role' / 'secret'
# Required for: Server-side 70% quiz grading, admin receipt approvals, certificates, and single-device session sync
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Supabase Direct / Pooler Database Connection String (Postgres URI)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Used for automated database migrations (e.g. npm run db:migrate)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# 5. Application Local Base URLs
# Used for absolute URL generation, OAuth redirects, and local browser testing
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
